# =============================================================================
# LDS Connect — configuration (copier en .env : `cp .env.example .env`)
# Toute la configuration passe par ces variables. Ne JAMAIS commiter le fichier .env.
# Les valeurs « à générer » se produisent avec : make keys
# =============================================================================

# --- Général -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# URL publique du site (utilisée dans les liens, QR codes, courriels)
PUBLIC_BASE_URL=http://localhost:3000
# URL publique de l'API
API_BASE_URL=http://localhost:8000
# Origines autorisées à appeler l'API depuis un navigateur (liste JSON)
CORS_ORIGINS=["http://localhost:3000"]
# Ports exposés sur la machine hôte
API_PORT=8000
WEB_PORT=3000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=lds
POSTGRES_PASSWORD=lds-dev-password
POSTGRES_DB=lds
# Utilisée hors Docker (make dev-local, tests). Dans Docker, elle est recalculée.
DATABASE_URL=postgresql+psycopg://lds:lds-dev-password@localhost:5432/lds

# --- Redis (cache, limitation de débit, temps réel) --------------------------
REDIS_URL=redis://localhost:6379/0

# --- Authentification (JWT) --------------------------------------------------
# Secret de signature des jetons : chaîne aléatoire d'au moins 32 octets (à générer)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# true en production (cookie de rafraîchissement transmis uniquement en HTTPS)
REFRESH_COOKIE_SECURE=false

# --- Chiffrement des données personnelles ------------------------------------
# Clé AES-256-GCM (32 octets en base64) pour CNIB et téléphones (à générer).
# ATTENTION : perdre cette clé rend ces données illisibles. La sauvegarder hors du serveur.
FIELD_ENCRYPTION_KEY=
# Clé HMAC (base64) des index aveugles : unicité/recherche sur champs chiffrés (à générer)
BLIND_INDEX_KEY=

# --- Signature des licences (Ed25519) ----------------------------------------
# Clé privée PEM encodée en base64 (à générer). La clé publique est exposée par l'API
# (/api/v1/licences/public-keys) pour la vérification hors connexion au stade.
LICENCE_SIGNING_KEY=
# Identifiant de la clé, inscrit dans chaque QR (permet une rotation de clé)
LICENCE_KEY_ID=lds-2027-1

# --- SMS (OTP des votes, phase 2) --------------------------------------------
# simulator : simulateur local (http://localhost:8090) | console : affichage dans les logs
SMS_PROVIDER=simulator
SMS_SIMULATOR_URL=http://localhost:8090

# --- Paiement mobile money (billetterie / vote payant, phase 2) --------------
# disabled par défaut | simulator : simulateur local
PAYMENT_PROVIDER=disabled
PAYMENT_SIMULATOR_URL=http://localhost:8090

# --- Stockage des fichiers (photos, documents) -------------------------------
# local : disque du serveur (volume Docker) | s3 : tout service compatible S3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=
S3_BUCKET=
# Identifiants S3 éventuels : AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# --- Courriel ----------------------------------------------------------------
# En local : Mailpit (interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@lds.local

# --- Web (Next.js) -----------------------------------------------------------
# URL de l'API vue depuis le serveur Next.js
API_INTERNAL_URL=http://localhost:8000
