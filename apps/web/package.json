{
  "name": "lds-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript ${API_URL:-http://localhost:8000}/api/v1/openapi.json -o src/lib/api-schema.ts",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@serwist/build": "^9.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
